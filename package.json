{
  "name": "impact-circle",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:backend": "turbo run dev --filter=backend",
    "db:generate": "turbo run db:generate --filter=@impact/db",
    "db:migrate": "turbo run db:migrate --filter=@impact/db",
    "db:push": "turbo run db:push --filter=@impact/db",
    "db:pull": "turbo run db:pull --filter=@impact/db",
    "db:seed": "turbo run db:seed --filter=@impact/db",
    "db:studio": "turbo run db:studio --filter=@impact/db",
    "check": "biome check --no-errors-on-unmatched --files-ignore-unknown=true",
    "lint": "biome lint --write --no-errors-on-unmatched",
    "fmt": "biome format --write --no-errors-on-unmatched",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@impact/typescript-config": "workspace:*",
    "turbo": "^2.9.6",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  }
}
